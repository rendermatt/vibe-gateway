:{$PORT} {
    handle /caddyhealth {
      respond "OK" 200
    }

    handle {
        # Delegates every credential check to userdb-admin, which verifies against
        # Postgres. A 2xx lets the request through; anything else (including the
        # 401 + WWW-Authenticate challenge) is returned to the client verbatim.
        #
        # The shared token proves the request came from this gateway. userdb-admin
        # is a public service, so without it anyone could brute-force gateway
        # credentials against /auth directly and bypass the ipAllowList.
        forward_auth {$AUTH_UPSTREAM} {
            uri /auth
            copy_headers X-Auth-User
            header_up X-Gateway-Token {$GATEWAY_TOKEN}
        }

        handle / {
            respond "OK" 200
        }

        @route path_regexp route ^/([^/]+)(/.*)?$

        handle @route {
            rewrite * {re.route.2}
            reverse_proxy {re.route.1}:{$DOWNSTREAM_PORT}
        }
    }
}
